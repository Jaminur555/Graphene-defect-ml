# graphene thermal vibration run, generated by graphene_defect_ml

units metal
dimension 3
boundary p f p
atom_style molecular
read_data sheet.data

group free molecule 1
group fixed molecule 2

pair_style airebo 2.0
pair_coeff * * CH_modified.airebo C

velocity free create 300.0 12345 mom yes rot yes dist gaussian
velocity fixed set 0.0 0.0 0.0

fix freeze fixed setforce 0.0 0.0 0.0

compute freetemp free temp

timestep 0.001
thermo 1000
thermo_style custom step c_freetemp pe etotal press

#==== Stage 1: NVT relax, 10 ps ====
dump relax_full all custom 50 relax_structure.lammpstrj id x y z
dump_modify relax_full sort id
fix nvt_relax free nvt temp 300.0 300.0 0.1
run 10000
unfix nvt_relax
undump relax_full

#=== Stage 2: NVT vibrate, 30 ps, dump out-of-plane displacement ====
compute ydisp free displace/atom
dump vib free custom 50 vibration.lammpstrj id x y z c_ydisp[2]
dump_modify vib sort id
dump full_struct all custom 50 full_structure.lammpstrj id x y z
dump_modify full_struct sort id
fix nvt_vibrate free nvt temp 300.0 300.0 0.1
run 30000
unfix nvt_vibrate
